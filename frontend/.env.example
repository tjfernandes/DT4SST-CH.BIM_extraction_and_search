# HBIM frontend — example environment configuration
# Copy to frontend/.env (git-ignored) and fill locally.
#
# VITE_* variables are inlined into the browser bundle at build time.
# VITE_API_KEY is therefore a CLIENT-VISIBLE key, not a confidential server
# secret: provision it separately from any server-side key and rotate it
# independently. Never commit a real value.
VITE_API_KEY=

# Base URL of the backend API (default: http://localhost:8000)
# VITE_API_BASE_URL=http://localhost:8000
