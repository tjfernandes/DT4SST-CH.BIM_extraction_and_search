# HBIM RAG — example environment configuration
# Version this file in Git. Never place real credentials or operational hosts here.
# Create backend/.env locally from this template and keep it ignored by Git.

# Application environment
APP_ENV=development
LOG_LEVEL=INFO

# OpenSearch — fictitious values only.
# OPENSEARCH_HOST accepts a pure hostname (recommended) or a full URL;
# a scheme/port embedded in the URL must not conflict with
# OPENSEARCH_SCHEME/OPENSEARCH_PORT (conflicts fail fast at validation).
OPENSEARCH_HOST=opensearch.example.test
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=https
OPENSEARCH_USERNAME=example-user
OPENSEARCH_PASSWORD=

# When omitted, SSL is inferred only from OPENSEARCH_SCHEME (https => true).
# It is never inferred from the presence of credentials.
# OPENSEARCH_USE_SSL=true

# Secure default (true). A local development cluster over plain http
# (OPENSEARCH_SCHEME=http) or with self-signed certificates must opt out
# explicitly, e.g. OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_SSL_SHOW_WARN=false

# OpenSearch client reliability
OPENSEARCH_TIMEOUT=30
OPENSEARCH_MAX_RETRIES=3
OPENSEARCH_RETRY_ON_TIMEOUT=true

# Current logical index; later milestones may replace this with versioned aliases.
OPENSEARCH_INDEX=bim_elements

# API authentication and hardening (HBIM-003)
# Fail closed: auth defaults to enabled; with auth enabled, API_KEYS must be
# a non-empty JSON array or comma-separated list (each key is a secret).
API_AUTH_ENABLED=true
API_KEYS=
# /metrics requires the API key unless explicitly made public.
METRICS_PUBLIC=false
# Comma-separated or JSON list of allowed origins; empty list denies all
# cross-origin requests. Local Vite dev server origin shown below.
CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
# json (structured, one object per line) or text (human-readable, local dev).
LOG_FORMAT=json

# Temporary legacy aliases still accepted during migration (with a
# DeprecationWarning) — do not define them here:
# OPENSEARCH_USER
# USE_SSL
# VERIFY_CERTS
# SSL_SHOW_WARN

# --- HBIM-073 §35: document hybrid retrieval (default OFF, fail-closed) ---
# Enabling requires every identity below; a missing value keeps the route
# degraded exactly as before HBIM-073. Secrets stay EMPTY in this file.
DOCUMENT_ACTIVATION_ENABLED=false
DOCUMENT_CHUNK_ALIAS=hbim_chunks
DOCUMENT_PAGE_SIZE=10
DOCUMENT_SNAPSHOT_SIGNING_SECRET=
DOCUMENT_SNAPSHOT_TTL_SECONDS=3600
DOCUMENT_EXPECTED_EMBEDDING_SPACE=
DOCUMENT_EXPECTED_PROJECTION_VERSION=
DOCUMENT_EXPECTED_RERANKER_DECISION_SHA256=

# --- HBIM-082 §33/§72: Neo4j graph retrieval (default OFF, fail-closed) ---
# With NEO4J_ENABLED unset or false the graph route degrades to "structured"
# exactly as it did before activation, and no driver is ever constructed.
# Enabling requires the URI, the username and the password together: any one
# missing keeps the route degraded rather than failing a request. The password
# stays EMPTY in this file and is never committed.
NEO4J_ENABLED=false
NEO4J_URI=
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Bounds. Retrieval is deterministic and bounded: depth is drawn from the
# closed set 1..6, and the result and path limits are applied inside Cypher.
NEO4J_CONNECTION_TIMEOUT_S=10
NEO4J_ACQUISITION_TIMEOUT_S=30
NEO4J_MAX_POOL_SIZE=20
NEO4J_TRANSACTION_TIMEOUT_S=30
NEO4J_QUERY_TIMEOUT_S=5
NEO4J_MAX_QUERY_DEPTH=4
NEO4J_MAX_RESULTS=50
NEO4J_MAX_PATHS=25
